{
  "expo": {
    "name": "Vector Lift",
    "slug": "lift-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifttrack",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#007088",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "dev.svindland.vector.lift",
      "appleTeamId": "9HAG9PT8LJ",
      "infoPlist": {
        "CFBundleDisplayName": "Lift",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#22d3ee"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "package": "dev.svindland.vector.lift"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#22d3ee",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#071017"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a training program to read it on this phone.",
          "cameraPermission": "Photograph a training program to read it on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "fr",
            "de",
            "it",
            "pt",
            "nl",
            "sv",
            "ja",
            "ko",
            "zh-Hans"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "Import your body weight into Vector Lift for bodyweight exercises when you choose to sync.",
          "NSHealthUpdateUsageDescription": "Save the body weights you log and your finished workouts to Apple Health when you choose to sync."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-rationale",
      "./plugins/with-scene-delegate",
      [
        "./plugins/with-kotlin-plugin-version",
        {
          "version": "2.2.21"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.2.21"
          }
        }
      ],
      "expo-background-task",
      "expo-quick-actions",
      "expo-sharing",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "dev.svindland.vector.lift.LiveActivity",
                  "entitlements": {}
                },
                {
                  "bundleIdentifier": "dev.svindland.vector.lift.watchkitapp",
                  "targetName": "LiftWatch",
                  "entitlements": {
                    "com.apple.developer.healthkit": true
                  }
                }
              ]
            }
          }
        },
        "projectId": "8ca11604-7812-4cb4-bd5f-909d3d16bc9d"
      }
    }
  }
}
